PORT=3001
# Cualquier texto largo y aleatorio. En Docker lo define docker-compose.yml.
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Valores para correr la API fuera de Docker (docker compose up -d postgres localstack).
# Dentro de Docker, compose usa "postgres" y "localstack" como host.
DATABASE_URL=postgres://clondrive:clondrive@localhost:5432/clondrive

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localhost:4566
S3_BUCKET=clon-drive
SQS_QUEUE_URL=http://localhost:4566/000000000000/uploads

# Carpeta de temporales de subida (la API escribe y el worker lee). En Docker es el volumen /uploads.
UPLOAD_DIR=./uploads
# Tamaño máximo por archivo en bytes (1 GB)
MAX_FILE_SIZE=1073741824
